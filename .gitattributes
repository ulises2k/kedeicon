# Normalize everything to LF in the repo and on checkout — this project runs on
# Linux; CRLF would break shell scripts (#!/bin/sh\r) and here-docs.
* text=auto eol=lf
*.c   text eol=lf
*.h   text eol=lf
*.py  text eol=lf
*.sh  text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.service text eol=lf
Makefile  text eol=lf
